  "description": "Use Claude and Gemini models on Google Cloud Vertex AI / Gemini Enterprise Agent Platform from pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "gcp",
    "google-cloud",
    "agent-platform",
    "vertex-ai",
    "gemini",
    "anthropic",
    "claude",
    "oauth"
  ],
  "author": {
    "name": "Nils Klüwer",
    "url": "https://github.com/nilskluewer"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nilskluewer/pi-gcp-agent-platform.git"
  },
  "bugs": {
    "url": "https://github.com/nilskluewer/pi-gcp-agent-platform/issues"
  },
  "homepage": "https://github.com/nilskluewer/pi-gcp-agent-platform#readme",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/gcp-agent-platform/index.ts"
    ]
  },
  "dependencies": {
    "@anthropic-ai/vertex-sdk": "^0.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "pack:dry": "npm pack --dry-run --registry=https://registry.npmjs.org/",
